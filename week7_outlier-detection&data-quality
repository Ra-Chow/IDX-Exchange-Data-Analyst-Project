# Filter dataset to create clean analysis-ready version (excluding flagged outliers)
sold_clean = sold_flagged[~sold_flagged["any_outlier_flag"]].copy()
listings_clean = listings_flagged[~listings_flagged["any_outlier_flag"]].copy()


def print_impact_comparison(df_before, df_after, name):
  print(f"\n{name} Dataset Impact Analysis (Dataset Size & Median Comparison):")
  print(f"  -> Row Count Before Filtering : {len(df_before):,}")
  print(f"  -> Row Count After Filtering  : {len(df_after):,}")
  print(
      f"  -> Total Outlier Rows Removed : {len(df_before) - len(df_after):,}"
      f" ({((len(df_before) - len(df_after))/len(df_before))*100:.2f}%)"
  )
  print("\n  Metric Median & Mean Comparison:")

  price_field = "ClosePrice" if name == "Sold" else "ListPrice"
  fields_to_compare = [price_field, "LivingArea", "DaysOnMarket"]

  for field in fields_to_compare:
    if field in df_before.columns:
      median_before = df_before[field].median()
      median_after = df_after[field].median()
      mean_before = df_before[field].mean()
      mean_after = df_after[field].mean()

      print(f"    * {field:12s}:")
      print(
          f"        Median -> Before: {median_before:12,.2f} | After:"
          f" {median_after:12,.2f}"
      )
      print(
          f"        Mean   -> Before: {mean_before:12,.2f} | After:"
          f" {mean_after:12,.2f}"
      )


print_impact_comparison(sold_flagged, sold_clean, "Sold")
print_impact_comparison(listings_flagged, listings_clean, "Listings")

